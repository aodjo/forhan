import { app, BrowserWindow, type BaseWindow } from "electron";
import { unlinkSync } from "node:fs";
import * as fs from "node:fs/promises";
import * as path from "node:path";
import { randomUUID } from "node:crypto";

/** Application-owned cache subdirectory containing only generated preview PDFs. */
const CACHE_DIRECTORY = "print-previews";
/** Live preview windows used to route native menu actions to the correct snapshot. */
const previews = new Set<BrowserWindow>();

/**
 * Identify a live PDF snapshot without trusting its displayed title or URL.
 *
 * Only windows created by this module can receive preview-specific menu actions.
 * @param {BaseWindow | null | undefined} window - Currently focused native window.
 * @returns {boolean} Whether it is an owned preview window.
 * @example
 * isPreviewWindow(BrowserWindow.getFocusedWindow());
 */
export function isPreviewWindow(
  window: BaseWindow | null | undefined,
): window is BrowserWindow {
  return window instanceof BrowserWindow && previews.has(window);
}
/** Recognizes only the randomly named preview files created by this module. */
const PREVIEW_FILENAME =
  /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\.forhan-preview\.pdf$/;

/**
 * Resolve the private preview cache for the current application profile.
 *
 * Explicit test profiles and independent user profiles never share cached PDFs.
 * @returns {string} Absolute application-owned cache directory.
 * @example
 * const directory = previewDirectory();
 */
function previewDirectory(): string {
  return path.join(app.getPath("userData"), CACHE_DIRECTORY);
}

/**
 * Remove a generated preview after its window closes.
 *
 * Only files in the explicit cache with the module's generated name pattern can
 * be unlinked. Synchronous unlink completes before ordinary application exit;
 * files still held by an OS viewer are retried during the next startup sweep.
 * @param {string} file - Absolute PDF filename created by this module.
 * @returns {void} Removes the owned file or leaves it for startup recovery.
 * @throws {Error} If a caller supplies a path outside the preview cache.
 * @example
 * removePreview(file); // Never recursively deletes a directory.
 */
function removePreview(file: string): void {
  if (
    path.dirname(file) !== previewDirectory() ||
    !PREVIEW_FILENAME.test(path.basename(file))
  )
    throw new Error("Invalid preview cleanup path.");
  try {
    unlinkSync(file);
  } catch (error) {
    if ((error as NodeJS.ErrnoException).code !== "ENOENT")
      console.warn("A preview file will be removed on the next startup.");
  }
}

/**
 * Clear generated previews left behind by an interrupted application process.
 *
 * Runs only after this profile's single-instance lock is acquired. Unrelated
 * files and directories are retained; symlinks are never followed for deletion.
 * @async
 * @returns {Promise<void>} Resolves after removing stale owned regular files.
 * @throws {Error} If the cache directory cannot be inspected.
 * @example
 * await clearStalePreviews();
 */
export async function clearStalePreviews(): Promise<void> {
  try {
    for (/** Entry inspected within the explicitly application-owned cache directory. */ const entry of await fs.readdir(
      previewDirectory(),
      { withFileTypes: true },
    )) {
      if (entry.isFile() && PREVIEW_FILENAME.test(entry.name))
        removePreview(path.join(previewDirectory(), entry.name));
    }
  } catch (error) {
    if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
  }
}

/**
 * Display a generated print-layout PDF in Chromium's built-in PDF viewer.
 *
 * The viewer receives PDF bytes rather than editable HTML, has no preload or
 * Node access, and cannot navigate or open external windows. The source editor
 * remains editable; this window is an independent snapshot with zoom, page
 * navigation and printer controls supplied by the cross-platform PDF viewer.
 * @async
 * @param {Uint8Array} bytes - PDF generated by the isolated print renderer.
 * @param {string} title - Human-readable document caption.
 * @param {BrowserWindow} owner - Editor owning this snapshot window.
 * @returns {Promise<void>} Resolves once the preview document is loaded and shown.
 * @throws {Error} If the cache, PDF file or viewer cannot be created or loaded.
 * @example
 * await showPdfPreview(pdf, 'Report', editorWindow);
 */
export async function showPdfPreview(
  bytes: Uint8Array,
  title: string,
  owner: BrowserWindow,
): Promise<void> {
  await fs.mkdir(previewDirectory(), { recursive: true, mode: 0o700 });
  /** Random absolute path containing no renderer-provided filename or path text. */
  const file = path.join(
    previewDirectory(),
    randomUUID() + ".forhan-preview.pdf",
  );
  /** Preview window is assigned only after successful native construction. */
  let preview: BrowserWindow | undefined;
  /** Ownership is established only after exclusive creation succeeds. */
  let fileCreated = false;
  try {
    /** Exclusive file handle prevents overwriting an existing cache entry. */
    const handle = await fs.open(file, "wx", 0o600);
    fileCreated = true;
    try {
      await handle.writeFile(bytes);
    } finally {
      await handle.close();
    }
    preview = new BrowserWindow({
      show: false,
      width: 1100,
      height: 850,
      parent: owner,
      title: title + " - 미리 보기",
      webPreferences: {
        nodeIntegration: false,
        contextIsolation: true,
        sandbox: true,
        plugins: true,
        spellcheck: false,
      },
    });
    preview.setMenu(null);
    previews.add(preview);
    preview.webContents.setWindowOpenHandler(
      /**
       * Refuse popup windows requested by a preview document.
       *
       * Viewing the local PDF cannot open a browser or grant an external page access.
       * @returns {{action: 'deny'}} Denies the new window.
       * @example
       * // An external PDF link cannot open an application window.
       */
      () => ({ action: "deny" }),
    );
    preview.webContents.on(
      "will-navigate",
      /**
       * Keep the preview on its generated local PDF.
       *
       * Programmatic initial loading remains permitted; document navigation is denied.
       * @param {Electron.Event} event - Cancellable viewer navigation.
       * @returns {void} Prevents changing the preview's document.
       * @example
       * // Clicking a link cannot replace the preview with a web page.
       */
      (event) => event.preventDefault(),
    );
    preview.on(
      "page-title-updated",
      /**
       * Keep the source document caption instead of a private cache filename.
       *
       * PDF viewer metadata is not allowed to replace the window's visible title.
       * @param {Electron.Event} event - Cancellable title update.
       * @returns {void} Retains the document's preview caption.
       * @example
       * // The window remains labelled Report - 미리 보기.
       */
      (event) => event.preventDefault(),
    );
    preview.once(
      "closed",
      /**
       * Release the generated document when its owned viewer closes.
       *
       * Only the file captured by this preview is removed, leaving other snapshots intact.
       * @returns {void} Removes the application's temporary PDF.
       * @example
       * // Closing a preview never modifies the original HWP document.
       */
      () => {
        previews.delete(preview!);
        removePreview(file);
      },
    );
    await preview.loadFile(file);
    preview.show();
  } catch (error) {
    if (preview && !preview.isDestroyed()) preview.destroy();
    if (fileCreated) removePreview(file);
    throw error;
  }
}
