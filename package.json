{
  "name": "forhan",
  "version": "0.1.0",
  "description": "포한 — 한글이 없는 사람들을 위한 문서 편집기",
  "author": "Forhan contributors",
  "private": true,
  "type": "module",
  "main": "electron-dist/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && node scripts/build-electron.ts",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "prestart": "node node_modules/electron/install.js",
    "test": "node --test tests/*.test.ts",
    "test:ui": "playwright test",
    "test:packaged": "node scripts/test-packaged.ts",
    "test:ime:windows": "node scripts/test-windows-ime.ts",
    "pack": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win portable",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --config.mac.identity=- --config.mac.entitlements=build/entitlements.mac.adhoc.plist --config.mac.entitlementsInherit=build/entitlements.mac.adhoc.plist",
    "dist:mac:signed": "npm run build && electron-builder --mac dmg zip"
  },
  "dependencies": {
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-strike": "^3.32.2",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/extension-text-align": "^3.0.0",
    "@tiptap/extension-text-style": "^3.0.0",
    "@tiptap/extension-underline": "^3.32.2",
    "@tiptap/starter-kit": "^3.0.0",
    "bidi-js": "1.1.0",
    "cfb": "^1.2.2",
    "fast-xml-parser": "^5.0.0",
    "fflate": "^0.8.2",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.6",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "5.4.624",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "org.forhan.editor",
    "productName": "포한",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-dist/**/*",
      "licenses/**/*",
      "!node_modules/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": [
          "hwpx",
          "hwp",
          "fhn"
        ],
        "name": "한글 문서",
        "role": "Editor"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signExecutable": false,
      "target": [
        "portable"
      ],
      "artifactName": "Forhan-${version}-Windows.${ext}"
    },
    "mac": {
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Forhan-${version}-macOS-${arch}.${ext}"
    },
    "dmg": {
      "backgroundColor": "#ffffff"
    }
  }
}
